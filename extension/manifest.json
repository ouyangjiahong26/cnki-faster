{
  "manifest_version": 3,
  "name": "CNKI Faster 知网精简加速",
  "version": "0.1.0",
  "description": "按模块移除知网文献页的 AI 推荐、引文网络、相关文献推荐等内容，并拦截广告与埋点请求，只保留文献信息与 PDF/CAJ 下载。",
  "author": "ouyangjiahong",
  "minimum_chrome_version": "102",
  "browser_specific_settings": {
    "gecko": {
      "id": "cnki-faster@ouyangjiahong",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.cnki.net/*",
    "*://*.cnki.com.cn/*",
    "*://*.nudt.edu.cn/*",
    "*://hm.baidu.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["config.js", "rules.js", "background.js"]
  },
  "action": {
    "default_title": "CNKI Faster 设置",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.cnki.net/*", "*://*.cnki.com.cn/*", "*://*.nudt.edu.cn/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
